# Copy to .env.local. Everything here is PUBLIC — Vite inlines VITE_* into the
# bundle. Firebase web config is designed to be public; access is controlled by
# security rules and by the backend, never by hiding these values.

# DEV: /api/v1 is proxied to the local API by vite.config.ts.
#
# PRODUCTION: the app is on Firebase Hosting and the API is on Render — two
# different origins, and Hosting does not proxy. This MUST be the absolute
# Render URL in a production build, e.g.
#   VITE_API_BASE_URL=https://internlink-2g0u.onrender.com/v1
# Set it as a GitHub Actions repository variable (see .github/workflows/deploy.yml),
# and add the Hosting domains to CORS_ORIGINS on Render or every call is blocked.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
