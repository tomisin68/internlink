# ---------------------------------------------------------------------------
# InternLink API — copy to .env and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_VERSION=v1

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Firebase Admin -------------------------------------------------------
# From Firebase console → Project settings → Service accounts → Generate key.
# Keep the private key on ONE line with literal \n sequences for the newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Point at the local emulator instead of production Firestore during dev.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- Cloudinary (SRS §7.1) ------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=internlink

# --- Resend (SRS §7.2) ----------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=InternLink <noreply@internlink.app>

# --- Anti-abuse (SRS §4.11) ----------------------------------------------
# FR-1103 — how long a new account stays throttled.
NEW_ACCOUNT_RESTRICTION_HOURS=24
# FR-1102 — daily caps per account.
MAX_CONNECTION_REQUESTS_PER_DAY=40
MAX_COLD_MESSAGES_PER_DAY=15
