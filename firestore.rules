rules_version = '2';

// =============================================================================
// InternLink Firestore rules
// -----------------------------------------------------------------------------
// GOVERNING PRINCIPLE: clients read, the API writes.
//
// SRS §2.1 makes this platform API-first and §5.2 requires role-based access
// control "enforced server-side on every endpoint, never trusted from client
// state". The backend uses the Admin SDK, which bypasses these rules entirely,
// so every write path is already validated, rate-limited and audited there.
//
// Allowing client writes would mean reimplementing all of that logic a second
// time in a language with no tests, and every divergence between the two
// becomes a security hole. So: `allow write: if false` is the default, and it
// is deliberate. A client write failing is the system working.
//
// Reads ARE granted, scoped tightly, because the web app uses realtime
// listeners for messaging — a thread that updates live beats polling.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isSelf(accountId) {
      return signedIn() && uid() == accountId;
    }

    // Custom claims minted by the API (see middleware/auth.ts).
    function claims() {
      return request.auth.token;
    }

    function isAdmin() {
      return signedIn() && 'roles' in claims() && claims().roles.hasAny(['admin']);
    }

    // A suspended or banned account keeps a valid token until it expires.
    // Reads are refused for the remainder of that window.
    function inGoodStanding() {
      return signedIn()
        && (!('status' in claims()) || claims().status in ['active', 'restricted']);
    }

    function canRead() {
      return inGoodStanding();
    }

    // ------------------------------------------------------------- accounts --
    // A profile is public-ish by nature on a professional network, but the
    // account document also carries email and verification state. Full reads
    // are limited to the owner and admins; everyone else goes through the API,
    // which returns a redacted view.
    match /accounts/{accountId} {
      allow get: if isSelf(accountId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------- intern profile --
    // FR-1105 — the owner controls visibility. `public` is readable by any
    // signed-in user; anything narrower is resolved by the API, which knows the
    // connection graph. Rules cannot cheaply check "are these two connected",
    // so they refuse rather than guess.
    match /internProfiles/{accountId} {
      allow get: if isSelf(accountId)
                 || isAdmin()
                 || (canRead() && resource.data.visibility == 'public');
      allow list: if isAdmin();
      allow write: if false;
    }

    match /recruiterProfiles/{accountId} {
      allow get: if isSelf(accountId) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------- companies --
    // Company pages are public to signed-in users (FR-1008). Verification
    // documents are NOT stored here — they live in Cloud Storage under rules
    // that admit only admins.
    match /companies/{companyId} {
      allow get, list: if canRead();
      allow write: if false;
    }

    // -------------------------------------------------------------- listings --
    // Anyone signed in may browse. Drafts leak nothing useful on their own, but
    // they are still filtered: a competitor should not read an unpublished role.
    match /listings/{listingId} {
      allow get: if canRead() && (resource.data.status == 'active' || isAdmin());
      allow list: if canRead();
      allow write: if false;
    }

    // ---------------------------------------------------------- applications --
    // Only the candidate and the hiring company. Note this grants the recruiter
    // the whole document including `internalNotes` — that FR-404 redaction is
    // applied by the API when serialising to an intern, and the intern's own
    // read here is scoped by internAccountId, so they never see another
    // candidate's notes.
    match /applications/{applicationId} {
      allow get: if isSelf(resource.data.internAccountId) || isAdmin();
      allow list: if false; // Always through the API — it enforces company scope.
      allow write: if false;
    }

    // ----------------------------------------------------------- connections --
    match /connections/{connectionId} {
      allow get, list: if canRead() && uid() in resource.data.participantIds;
      allow write: if false;
    }

    // Who *you* follow is yours to read. Who follows someone else is not: a
    // follower list is a contact list, and the API returns only the count.
    match /follows/{followId} {
      allow get, list: if canRead() && resource.data.followerId == uid();
      allow write: if false;
    }

    // Blocks are readable only by the person who created them. Letting someone
    // discover they have been blocked invites them to work around it.
    match /blocks/{blockId} {
      allow get, list: if canRead() && resource.data.blockerId == uid();
      allow write: if false;
    }

    // --------------------------------------------------------------- posts ---
    // The feed is assembled and ranked by the API. Direct reads are allowed so
    // a post detail view can subscribe to its own reaction count in realtime.
    // Flagged posts are hidden from everyone but their author and admins.
    match /posts/{postId} {
      allow get: if canRead()
                 && (resource.data.isFlagged == false
                     || isSelf(resource.data.authorAccountId)
                     || isAdmin());
      allow list: if canRead();
      allow write: if false;

      match /comments/{commentId} {
        allow get, list: if canRead();
        allow write: if false;
      }
    }

    match /postReactions/{reactionId} {
      allow get, list: if canRead() && resource.data.accountId == uid();
      allow write: if false;
    }

    // Same shape as postReactions: a viewer may read their own like state, and
    // the aggregate lives denormalised on the comment itself.
    match /commentReactions/{reactionId} {
      allow get, list: if canRead() && resource.data.accountId == uid();
      allow write: if false;
    }

    // ------------------------------------------------------------ messaging --
    // This is the reason client reads exist at all. A participant subscribes to
    // their thread and its messages, and the UI updates live instead of polling.
    match /messageThreads/{threadId} {
      allow get: if canRead() && uid() in resource.data.participantIds;
      allow list: if canRead() && uid() in resource.data.participantIds;
      allow write: if false;

      // Messages inherit access from the parent thread. `get()` costs a
      // document read per rule evaluation, which is the price of not
      // duplicating participantIds onto every message.
      match /messages/{messageId} {
        allow get, list: if canRead()
                         && uid() in get(/databases/$(database)/documents/messageThreads/$(threadId)).data.participantIds;
        allow write: if false;
      }
    }

    // -------------------------------------------------------- notifications --
    match /notifications/{notificationId} {
      allow get, list: if canRead() && resource.data.accountId == uid();
      allow write: if false;
    }

    // FCM registrations. Closed in both directions: a token is a capability to
    // send a push to someone's device, and there is no client-side reason to
    // read one back — the app already holds its own token from the FCM SDK.
    match /pushTokens/{tokenId} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------- moderation ---
    // §9.3 — the queue is staff-only. A reporter learning the status of their
    // own report goes through the API, which returns only what is safe.
    match /moderationFlags/{flagId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Internal counters (FR-1102). No client has any business reading these —
    // exposing remaining quota tells an abuser exactly when to back off.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    match /adUnits/{adUnitId} {
      allow get, list: if canRead();
      allow write: if false;
    }

    match /adEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it — the default is closed on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
